# Environment Variables for Canva Snapper
# Copy this file to .env and fill in your real values
# NEVER commit .env to git!

# ─── Firebase ───────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Your Apps → Web App
VITE_FIREBASE_API_KEY=AIzaSyDqd_TSh_UgEee7iuvF7GzUO-8p5Eij1GQ
VITE_FIREBASE_AUTH_DOMAIN=canva-snapper-pro-9e1b3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=canva-snapper-pro-9e1b3
VITE_FIREBASE_STORAGE_BUCKET=canva-snapper-pro-9e1b3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=942739614397
VITE_FIREBASE_APP_ID=1:942739614397:web:9586d5ba1128aff10165d4

# ─── Google OAuth ────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Type: Chrome Extension. Used in manifest.json oauth2.client_id and gcm_sender_id
GOOGLE_OAUTH_CLIENT_ID=481253626923-h23hdsvoaaun68fhlg1ngi3mseckb6bf.apps.googleusercontent.com
GOOGLE_GCM_SENDER_ID=481253626923

# ─── Firebase Cloud Functions ────────────────────────────────
# Format: https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net
VITE_FUNCTIONS_BASE_URL=https://us-central1-canva-snapper-pro-9e1b3.cloudfunctions.net/polarWebhook



# ─── Polar.sh ────────────────────────────────────────────────
# Get from: https://polar.sh/dashboard → Settings → API Keys
# POLAR_ACCESS_TOKEN goes into Firebase Functions config, NOT into Vite .env
# (It's a server-side secret — never expose it in the extension bundle!)
#
# In Firebase Functions, set it with:
#   firebase functions:secrets:set POLAR_ACCESS_TOKEN
#   firebase functions:secrets:set POLAR_WEBHOOK_SECRET
#   firebase functions:secrets:set POLAR_PRO_PRODUCT_ID
#   firebase functions:secrets:set POLAR_CREDITS_PRODUCT_ID
